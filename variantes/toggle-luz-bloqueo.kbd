;; Kanata: mouse con el teclado (variante toggle + luz + bloqueo de escritura)
;; CapsLock          -> activa / desactiva el modo mouse (toggle)
;; Esc               -> también sale del modo mouse
;; Luz de CapsLock   -> encendida = modo mouse
;; Shift + CapsLock  -> CapsLock normal (mayúsculas)
;; Modo mouse (las demás teclas que escriben quedan bloqueadas;
;; modificadores, flechas y F1-F12 siguen funcionando):
;;   I J K L       : mover puntero (arriba/izq/abajo/der), con aceleración
;;   F o Espacio   : clic izquierdo (mantener = arrastrar)
;;   D             : clic derecho
;;   S             : clic del medio
;;   U / O         : scroll arriba / abajo
;;   A (mantenido) : modo preciso, 30% de velocidad

(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv 1 2 3 4 5 6 7 8 9 0 min eql bspc
  tab q w e r t y u i o p lbrc rbrc
  caps a s d f g h j k l scln apos \ ret
  102d z x c v b n m comm . / spc
  esc del
  kp0 kp1 kp2 kp3 kp4 kp5 kp6 kp7 kp8 kp9 kp+ kp- kp* kp/ kp. kprt
)

(defalias
  ;; El modo mouse también activa el Bloq Mayús real, así la luz indica el modo
  cap  (fork (multi caps (layer-switch mouse)) caps (lsft rsft))
  off  (multi caps (layer-switch base))
  mu   (movemouse-accel-up    4 700 1 16)
  ml   (movemouse-accel-left  4 700 1 16)
  md   (movemouse-accel-down  4 700 1 16)
  mr   (movemouse-accel-right 4 700 1 16)
  wu   (mwheel-up   50 120)
  wd   (mwheel-down 50 120)
  slow (movemouse-speed 30)
)

(deflayer base
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  @cap _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
)

(deflayer mouse
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX @wu @mu @wd XX XX XX
  @off @slow mmid mrgt mlft XX XX @ml @md @mr XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX mlft
  @off XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX
)
