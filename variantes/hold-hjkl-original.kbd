;; Kanata: mouse con el teclado
;; CapsLock tocado  -> CapsLock normal
;; CapsLock mantenido -> capa "mouse":
;;   H J K L / flechas : mover puntero (con aceleración)
;;   U I O             : clic izquierdo / medio / derecho
;;   N M               : scroll abajo / arriba
;;   Shift izquierdo   : movimiento lento (precisión)

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps
  h    j    k    l
  u    i    o
  n    m
  lsft
  left down up   rght
)

(defalias
  cap  (tap-hold 200 200 caps (layer-while-held mouse))
  ml   (movemouse-accel-left  4 1000 1 8)
  md   (movemouse-accel-down  4 1000 1 8)
  mu   (movemouse-accel-up    4 1000 1 8)
  mr   (movemouse-accel-right 4 1000 1 8)
  wd   (mwheel-down 50 120)
  wu   (mwheel-up   50 120)
  slow (movemouse-speed 25)
)

(deflayer base
  @cap
  h    j    k    l
  u    i    o
  n    m
  lsft
  left down up   rght
)

(deflayer mouse
  _
  @ml  @md  @mu  @mr
  mlft mmid mrgt
  @wd  @wu
  @slow
  @ml  @md  @mu  @mr
)
